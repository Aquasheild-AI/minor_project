# ==============================================================================
# AquaShield Backend Environment Variables
# ==============================================================================

# Django Security
SECRET_KEY=your-django-secret-key-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-app.onrender.com
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://*.onrender.com

# Database Configuration (Neon PostgreSQL for Render / leave unset for local SQLite)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# Brevo (formerly Sendinblue) Transactional Email API (HTTPS REST API)
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=AquaShield
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# Google Gemini API (AI Chatbot & Analysis)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
